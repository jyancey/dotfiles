[gui]
	fontui = -family Monaco -size 14 -weight normal -slant roman -underline 0 -overstrike 0
	fontdiff = -family Monaco -size 14 -weight normal -slant roman -underline 0 -overstrike 0

[user]
	name = John Yancey
	email = joyancey@cisco.com

[core]
	excludesfile = $HOME/.gitignore_global
	editor = /usr/bin/vim

[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 

[mergetool "sourcetree"]
	cmd = /Applications/SourceTree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true

[pretty]
	graph = %C(blue)%h%C(reset) %C(green)%d%C(reset) %s %C(yellow)%cn <%ce>%C(reset) %C(red)[%cd]%C(reset)

[alias]
	br = branch -a --color=auto
	ci = commit
	co = checkout
	flist = flow feature list -v
	fs = flow feature start
	ff = flow feature finish
	fpub = flow feature publish
	ftrack = flow feature track
	fdiff = flow feature diff
	frebase = flow feature rebase
	fco = flow feature checkout
	fpull = flow feature pull
	rlist = flow release list -v
	rs = flow release start
	rf = flow release finish
	rpub = flow release publish
	rtrack = flow release track
	hlist = flow hotfix list -v
	hs = flow hotfix start
	hf = flow hotfix finish
	slist = flow support list -v
	ss = flow support start -F
	last = log -1 HEAD
	lg  = log --graph --pretty=graph --abbrev-commit --date=relative
	lga = log --graph --color=auto --pretty=graph --decorate=short --date=local --cherry-mark --all
	lgf = log --graph --color=auto --pretty=graph --full-history --all 
	lgl = log --graph --color=auto --pretty=graph --decorate=short --date=local --cherry-mark
	lgm = log --graph --color=auto --pretty=graph --decorate=short --date=local --cherry-mark --merges
	lg1 = log --pretty=oneline --abbrev-commit --decorate
	st = status -s
	unstage = reset HEAD --
	push-for-review = push origin HEAD:refs/for/master
	staged = diff --cached

[color]
	ui = auto

[mergetool]
	keepBackup = true

[branch "master"]
	rebase = true

[branch]
	autosetuprebase = always

[rebase]
	stat = true

[push]
	default = matching

[merge]
	ff = false
