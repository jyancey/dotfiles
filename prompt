# Define ANSI color sequences for bash, zsh has this built-in.
NO='\[\033[0m\]'      # Normal
BR='\[\033[1;31m\]'   # Bright Red
BB='\[\033[1;34m\]'   # Bright Blue
BY='\[\033[1;33m\]'   # Bright Yellow

# Define the actual prompt, which will look like:
# [~/path]           <-- Path in bright blue
# <login@hostname>$  <-- User @ Host in bright yellow, $ prompt in bright red
#
if [[ "${MYSHELL}" == "bash" ]]; then
  if [[ ${DEBUG} ]]; then
    echo "---> setting prompt for $MYSHELL"
  fi
  declare -x PS1="${BB}[\w]${NO}\n${BY}<\u@\h>${BR}\$${NO} "
fi
if [[ "${MYSHELL}" == "zsh" ]]; then
  if [[ ${DEBUG} ]]; then
    echo "---> setting prompt for $MYSHELL"
  fi
  # zsh doesn't support '\n' embedded into the prompt, sad.
  CR=$'\n'
  declare -x PS1="%F{blue}[%~]%f$CR%F{yellow}<%n@%m>%f%F{red}$%f "
fi
